# Where the Help Zone backend runs, and the shared admin key it expects.
BACKEND_API_URL=http://localhost:5000
ADMIN_API_KEY=

# Admin sign-in (a single account).
ADMIN_EMAIL=you@example.com
# Generate with:  node scripts/hash-password.mjs 'your-password'
ADMIN_PASSWORD_HASH=
# Signs the session cookie. Generate with:  openssl rand -hex 32
AUTH_SECRET=
